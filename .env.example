# Copy to `.env` (gitignored). Only needed when the Antigravity access token expires
# and Google OAuth refresh is required. Do not commit real values.
#
# Same names as MindSync, plus Notch aliases:
#   NOTCH_ANTIGRAVITY_CLIENT_ID / NOTCH_ANTIGRAVITY_CLIENT_SECRET
MINDSYNC_ANTIGRAVITY_CLIENT_ID=
MINDSYNC_ANTIGRAVITY_CLIENT_SECRET=
